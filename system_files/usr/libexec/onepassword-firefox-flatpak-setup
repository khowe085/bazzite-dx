#!/usr/bin/bash
# Stages what the Firefox flatpak needs to reach the host 1Password app through
# xdg-native-messaging-proxy. Runs at boot from onepassword-firefox-flatpak.service.
set -euo pipefail

EXT_ROOT="${ONEPASSWORD_FIREFOX_EXT_ROOT:-/var/lib/flatpak/extension}"
CONFIG_DIR="${ONEPASSWORD_FIREFOX_CONFIG_DIR:-/usr/share/ublue-os/firefox-config}"
ARCH="$(flatpak --default-arch)"

# The org.mozilla.firefox.systemconfig extension point maps this host directory to /app/etc/firefox,
# where the flatpak picks up default prefs. Flatpak looks for the extension under the app's own
# branch and Bazzite's manager only fills `stable`, so the beta Firefox this image installs would
# otherwise start without Bazzite's defaults and without the proxy pref.
for branch in stable beta; do
	install -Dm0644 -t "${EXT_ROOT}/org.mozilla.firefox.systemconfig/${ARCH}/${branch}/defaults/pref/" "${CONFIG_DIR}"/*.js
done

# The proxy is a session-bus service the sandbox cannot talk to until it is granted. Overrides are
# per app ID, so this covers every branch.
flatpak override --system --talk-name=org.freedesktop.NativeMessagingProxy org.mozilla.firefox
