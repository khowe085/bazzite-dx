#!/usr/bin/bash
# Init hook of the "ubuntu" distrobox (see /etc/distrobox/apps.ini). Distrobox runs it as root
# inside the Ubuntu box on every container start; the host's / is visible there under /run/host.
# Gives the box the host's SSH agent and commit signing through 1Password, then installs Claude
# Desktop from Anthropic's apt repository, the way their Linux docs describe.
set -euo pipefail

HOST="${CLAUDE_HOST_ROOT:-/run/host}"
BOX="${CLAUDE_BOX_ROOT:-}"

# SSH and Git signing through 1Password, as on the host (25-1password-git-signing.sh and
# 60-1password-agent.conf). The home directory is shared, so the agent socket and the user's own
# ~/.gitconfig (user.signingkey) are already here; the box lacks the host's system files and the
# signer. Done on every start, before the early exit below, so that image updates reach existing boxes
# and it works offline. Distrobox does not start the box when this hook fails, so each step only warns.
warn() { echo "claude-distrobox-init: $*" >&2; }
# The host's /opt/1Password leads through an absolute link (/var/opt/1Password -> /usr/lib/opt/1Password)
# that would resolve inside the box, so link the directory the image puts 1Password in. A 1Password
# installed in the box itself is left alone.
if [[ -d "$HOST/usr/lib/opt/1Password" ]] && { [[ -L "$BOX/opt/1Password" ]] || [[ ! -e "$BOX/opt/1Password" ]]; }; then
	{ mkdir -p "$BOX/opt" && ln -sfn "$HOST/usr/lib/opt/1Password" "$BOX/opt/1Password"; } ||
		warn "could not link /opt/1Password to the host's 1Password"
fi
# The host's system Git settings for signing, read from its file so they are kept in one place. The box
# follows the host for these keys, including one the host no longer sets.
if [[ -f "$HOST/etc/gitconfig" ]] && command -v git >/dev/null; then
	mkdir -p "$BOX/etc" || warn "could not create $BOX/etc"
	for key in gpg.format gpg.ssh.program commit.gpgsign; do
		if value="$(git config --file "$HOST/etc/gitconfig" --get "$key")"; then
			git config --file "$BOX/etc/gitconfig" --replace-all "$key" "$value" || warn "could not set $key"
		else
			# Exit status 5: the key was not set; nothing to do.
			git config --file "$BOX/etc/gitconfig" --unset-all "$key" 2>/dev/null || (($? == 5)) ||
				warn "could not unset $key"
		fi
	done
fi
if [[ -f "$HOST/etc/ssh/ssh_config.d/60-1password-agent.conf" ]]; then
	install -Dm0644 "$HOST/etc/ssh/ssh_config.d/60-1password-agent.conf" \
		"$BOX/etc/ssh/ssh_config.d/60-1password-agent.conf" || warn "could not install the 1Password SSH drop-in"
fi

KEY_URL=https://downloads.claude.ai/claude-desktop/key.asc
KEY_FPR=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE
REPO_URL=https://downloads.claude.ai/claude-desktop/apt/stable
KEYRING="${CLAUDE_KEYRING:-/usr/share/keyrings/claude-desktop-archive-keyring.asc}"
SOURCES="${CLAUDE_SOURCES:-/etc/apt/sources.list.d/claude-desktop.list}"

# Every start after the first takes this path, so it has to stay cheap and work offline. Ask dpkg
# about the package rather than PATH about a binary whose name is Anthropic's to change.
if [[ "$(dpkg-query -W -f='${db:Status-Status}' claude-desktop 2>/dev/null)" == installed ]]; then
	exit 0
fi

export DEBIAN_FRONTEND=noninteractive
key="$(mktemp)"
trap 'rm -f "$key"' EXIT

curl -fsSLo "$key" "$KEY_URL"
# Anthropic publishes this fingerprint in the install docs; trust no other key for the repository.
# The file becomes the repository's keyring as a whole, so it must hold that one key and nothing else.
keys="$(gpg --show-keys --with-colons "$key")"
if [[ "$(grep -c '^pub:' <<<"$keys")" != 1 ]] || ! grep -qx "fpr:::::::::${KEY_FPR}:" <<<"$keys"; then
	echo "the downloaded claude-desktop signing key is not exactly the key with fingerprint ${KEY_FPR}" >&2
	exit 1
fi
install -Dm0644 "$key" "$KEYRING"
echo "deb [arch=amd64,arm64 signed-by=${KEYRING}] ${REPO_URL} stable main" >"$SOURCES"

apt-get update
apt-get install -y claude-desktop
