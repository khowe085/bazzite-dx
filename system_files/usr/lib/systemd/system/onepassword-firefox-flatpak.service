[Unit]
Description=Configure the Firefox flatpak for 1Password native messaging via xdg-native-messaging-proxy
# Both scripts edit the same flatpak override file; serialise after Bazzite's manager.
After=bazzite-flatpak-manager.service
ConditionPathExists=/usr/bin/flatpak

[Service]
Type=oneshot
ExecStart=/usr/libexec/onepassword-firefox-flatpak-setup

[Install]
WantedBy=multi-user.target
