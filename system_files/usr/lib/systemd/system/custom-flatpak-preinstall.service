[Unit]
Description=Install the flatpaks listed in /usr/share/flatpak/preinstall.d
Wants=network-online.target
# Bazzite's manager adds the Flathub remote on first boot; run after it.
After=network-online.target bazzite-flatpak-manager.service
ConditionPathExists=/usr/share/flatpak/preinstall.d

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak preinstall --system -y

[Install]
WantedBy=multi-user.target
