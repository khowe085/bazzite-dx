[Unit]
Description=Set up Snapper snapshots of /var/home once
RequiresMountsFor=/var/home

[Service]
Type=oneshot
# The script keeps its "done" stamp here (STATE_DIRECTORY); delete it to have the setup run again.
StateDirectory=custom-home-snapshots
ExecStart=/usr/libexec/custom-home-snapshots-setup

[Install]
WantedBy=multi-user.target
